<Window x:Class="MaksLifeInChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MaksLifeInChat" KeyDown="Window_KeyDown" KeyUp="Window_KeyUp" MouseMove="Window_MouseMove" MouseDown="Window_MouseDown"
        mc:Ignorable="d" WindowStyle="None" WindowState="Maximized"
        Title="MainWindow" Height="600" Width="960">
    <Viewbox>
        <Grid Height="1200" Width="1920">
            <Canvas x:Name="mouseDynamicImageCanvas" Margin="5,5,5,155">
                <Image x:Name="mouseDynamicImage"></Image>
            </Canvas>
            <StackPanel x:Name="developInfo" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,25">
                <TextBlock FontSize="16" x:Name="frameCountTB"></TextBlock>
                <TextBlock FontSize="16" x:Name="timeCountTB"></TextBlock>
                <TextBlock FontSize="16" x:Name="spriteCountTB"></TextBlock>
                <TextBlock FontSize="16" x:Name="coordinatesTB"></TextBlock>
            </StackPanel>
            <Border Margin="5,5,5,155" BorderBrush="Black" BorderThickness="10">
                <Grid>
                    <Grid x:Name="gameUnitMapGrid"/>
                    <Grid x:Name="gameBuildingMapGrid"/>
                    <Grid x:Name="gamePlayerMapGrid"/>
                </Grid>
            </Border>
            <StackPanel Visibility="Collapsed" x:Name="toolBarStackPanel" Orientation="Horizontal" VerticalAlignment="Bottom" Height="155" HorizontalAlignment="Center">
                <Image Source="/Resource/hand.png" Height="100" Width="100"></Image>
                <Border x:Name="hand1Border" Margin="30,0,0,0" BorderBrush="Black" BorderThickness="8" Height="100" Width="100"></Border>
                <Border x:Name="hand2Border" Margin="30,0,0,0" BorderBrush="Black" BorderThickness="8" Height="100" Width="100"></Border>
                <Image Margin="60,0,0,0" Source="/Resource/inventory.png" Height="100" Width="100"></Image>
                <Border x:Name="inventory1Border" Margin="30,0,0,0" BorderBrush="Black" BorderThickness="8" Height="100" Width="100"></Border>
                <Border x:Name="inventory2Border" Margin="30,0,0,0" BorderBrush="Black" BorderThickness="8" Height="100" Width="100"></Border>
                <Border x:Name="inventory3Border" Margin="30,0,0,0" BorderBrush="Black" BorderThickness="8" Height="100" Width="100"></Border>
                <Border x:Name="inventory4Border" Margin="30,0,0,0" BorderBrush="Black" BorderThickness="8" Height="100" Width="100"></Border>
                <Image x:Name="buildingInterfaceImage" Margin="60,0,0,0" Height="100" Width="100"></Image>
                <Border Margin="30,0,0,0" BorderBrush="Black" BorderThickness="8" Height="100" Width="100">
                    <Button Background="Transparent" Click="Button_Building1">
                        <Image x:Name="building1Image"></Image>
                    </Button>
                </Border>
                <Border Margin="30,0,0,0" BorderBrush="Black" BorderThickness="8" Height="100" Width="100">
                    <Button Background="Transparent" Click="Button_Building2">
                        <Image x:Name="building2Image"></Image>
                    </Button></Border>
                <Image Margin="30,0,0,0" Source="/Resource/hp.png" Height="100" Width="100"></Image>
                <Rectangle Name="hpRectangle" Height="120" Width="12" Fill="#c10f17" VerticalAlignment="Bottom" Margin="0,0,0,18"></Rectangle>
                <Image Source="/Resource/mp.png" Height="100" Width="100"></Image>
                <Rectangle Name="mpRectangle" Height="120" Width="12" Fill="#2d36a6" VerticalAlignment="Bottom" Margin="0,0,0,18"></Rectangle>
                <Image Source="/Resource/stamina.png" Height="100" Width="100"></Image>
                <Rectangle Name="staminaRectangle" Height="120" Width="12" Fill="#1b8b3d" VerticalAlignment="Bottom" Margin="0,0,0,18"></Rectangle>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="dayCountTB" FontSize="24" FontWeight="Bold">0 д.</TextBlock>
                    <TextBlock x:Name="levelCountTB" FontSize="24" FontWeight="Bold">0 ур.</TextBlock>
                    <TextBlock x:Name="cableCountTB" FontSize="24" FontWeight="Bold">0 🍕</TextBlock>
                    <TextBlock x:Name="meatCountTB" FontSize="24" FontWeight="Bold">0 🔌</TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Viewbox>
</Window>
